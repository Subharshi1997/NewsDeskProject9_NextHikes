# --- Required ---
GROQ_API_KEY=your-groq-api-key
NEWSDATA_API_KEY=your-newsdata-api-key

# --- Optional providers (each degrades gracefully if unset -- see
# docs/NEWS_PROVIDERS.md for free-tier limits on each) ---
NEWS_API_KEY=your-newsapi-org-key
GNEWS_API_KEY=your-gnews-api-key

# --- Provider toggles (default: true). RSS needs no API key -- it reads
# config/rss_sources.json. ---
NEWS_PROVIDER_NEWS_DATA_ENABLED=true
NEWS_PROVIDER_RSS_ENABLED=true
NEWS_PROVIDER_NEWS_API_ENABLED=true
NEWS_PROVIDER_GNEWS_ENABLED=true

# --- Background ingestion ---
# Minutes between scheduled fetch/dedup/cluster/score/store cycles.
NEWS_FETCH_INTERVAL=15

# --- Optional ---
# Overrides the default SQLite file location (./news.db).
# NEWS_DB_PATH=news.db
