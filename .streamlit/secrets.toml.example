# Copy this file to secrets.toml (git-ignored) and set a real password to
# enable the access gate -- see docs/RUNBOOK.md "Authentication".
# If secrets.toml doesn't exist, or app_password is unset, the app runs
# unprotected (so a fresh local setup never locks you out before you've
# had a chance to configure one).
app_password = "choose-a-password"
